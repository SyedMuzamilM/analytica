{
  "name": "analytica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web analytics with Cloudflare-hosted and self-hosted editions.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime false",
    "setup:local": "node scripts/setup-local.mjs",
    "format": "prettier --write apps packages public scripts tests *.ts wrangler.jsonc package.json .github",
    "format:check": "prettier --check apps packages public scripts tests *.ts wrangler.jsonc package.json .github"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores this installation's accounts and analytics."
      },
      "SETUP_TOKEN": {
        "description": "A new random setup token, at least 32 characters. Required to create the owner."
      },
      "APP_SECRET": {
        "description": "A different random secret, at least 32 characters. Protects application credentials."
      }
    }
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
